# AWS SES email configuration
# Copy this file to .env and fill in your values

AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SES_EMAIL=noreply@fabrichq.ai

# Shown in email reply-to and support links
EMAIL_REPLY_TO=support@fabrichq.ai

# Sender name shown to candidates as "Team <name>", and {{Company Name}}
# in the confirmation email
EMAIL_COMPANY_NAME=Your Client

# Support address shown in the email ({{Support Email}}). Defaults to
# EMAIL_REPLY_TO.
EMAIL_SUPPORT=support@fabrichq.ai

# Confirmation email defaults. Edit the email in Admin > Email Templates;
# these are only used until a template is saved there (or after Reset).
# A file in email_templates/ and its subject line.
CONFIRMATION_EMAIL_TEMPLATE=default_slot_confirmed.html
CONFIRMATION_EMAIL_SUBJECT=Your AI Interview is confirmed – {{Job Name}}, {{Slot Date}} {{Start Time}} IST

# Public address candidates use. Booking links in exports are built
# from it, so they are right even when admins use another address.
BOOKING_BASE_URL=https://slot-booking.fabrichq.ai

# Candidate help FAQ linked in the page footer. Leave empty to hide it.
FAQ_LINK=

# Database file. Use a new file per client deployment.
DATABASE_PATH=instance/slots_pool.db

# Seconds to wait after a booking before sending the confirmation email.
# 0 sends immediately. The send runs on a background thread, so a long
# delay means an app restart within that window loses the email (it can
# be resent from Admin > Bookings).
EMAIL_CONFIRMATION_DELAY_SECONDS=300
