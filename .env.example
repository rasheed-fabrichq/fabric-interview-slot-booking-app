# AWS SES email configuration
# Copy this file to .env and fill in your values

AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SES_EMAIL=noreply@fabrichq.ai

# Shown in email reply-to and support links
EMAIL_REPLY_TO=support@fabrichq.ai

# Company name shown in email sender ("Team <company_name>")
EMAIL_COMPANY_NAME=Fabric

# Seconds to wait after a booking before sending the confirmation email.
# 0 sends immediately. The send runs on a background thread, so a long
# delay means an app restart within that window loses the email (it can
# be resent from Admin > Bookings).
EMAIL_CONFIRMATION_DELAY_SECONDS=300

# --- Slot reminders (reminder_worker.py) ---------------------------
# Run alongside the web app:  python reminder_worker.py

# How many minutes before a slot the reminder email goes out.
REMINDER_LEAD_MINUTES=15

# Seconds between passes. 60 keeps reminders accurate to the minute.
REMINDER_POLL_INTERVAL_SECONDS=60

# How late a missed reminder is still worth sending. If the worker was
# down over a slot's window, a reminder more than this many minutes
# past due is skipped rather than sent late.
REMINDER_GRACE_MINUTES=5
