# AWS SES email configuration
# Copy this file to .env and fill in your values
#
# Reply-to, CC, support email, FAQ link, email templates, reminder lead
# times and call settings are set per job in Admin > Communications; the
# values below are the defaults those fields start with. A job's company
# name has no default -- it is required when the job is created -- and
# neither do the AI call's spoken company and role.
#
# Public address of this app, used in the booking links sent by the
# follow-up email. Defaults to the address the admin panel is opened on.
BOOKING_BASE_URL=https://slot-booking.fabrichq.ai

AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SES_EMAIL=noreply@fabrichq.ai

# Shown in email reply-to and support links
EMAIL_REPLY_TO=support@fabrichq.ai

# Sender name fallback for the standalone send_followup_emails.py script
# only; the app always uses the job's own company name. and in the
# confirmation subject line.
EMAIL_COMPANY_NAME=Fabric

# Copied on every booking confirmation, comma-separated. Visible to the
# candidate in the Cc header, and each address gets one copy per booking.
EMAIL_CONFIRMATION_CC=

# Seconds to wait after a booking before sending the confirmation email.
# 0 sends immediately. The send runs on a background thread, so a long
# delay means an app restart within that window loses the email (it can
# be resent from Admin > Bookings).
EMAIL_CONFIRMATION_DELAY_SECONDS=300

# --- Slot reminders (reminder_worker.py) ---------------------------
# Run alongside the web app:  python reminder_worker.py

# How many minutes before a slot the reminder email goes out.
REMINDER_LEAD_MINUTES=15

# Seconds between passes. 60 keeps reminders accurate to the minute.
REMINDER_POLL_INTERVAL_SECONDS=60

# How late a missed reminder is still worth sending. If the worker was
# down over a slot's window, a reminder more than this many minutes
# past due is skipped rather than sent late.
REMINDER_GRACE_MINUTES=5

# --- Reminder calls (calling system integration) -------------------
# Off by default: turn on only once the calling system is reachable
# and the assistant id below is correct.
CALLS_ENABLED=false

# Where the calling system lives. The path is appended to the base.
CALLER_API_BASE_URL=http://localhost:8000
CALLER_API_PATH=/api/v1/call/
# Sent as the "x-pass-key" header the calling system authenticates on.
CALLER_PASS_KEY=fabrichqai
# Optional. Sent as "Authorization: Bearer <key>" when set.
CALLER_API_KEY=

# The assistant that runs the reminder call, and the persona it uses.
CALLER_ASSISTANT_ID=651dd10a-dac9-4166-8a4c-af7bde973170
CALLER_AGENT_TYPE=integrity_reminder
CALLER_AGENT_NAME=Riya
CALLER_COMPANY_NAME=Fabric

# Spoken aloud by the agent, so write it in words.
CALL_DISQUALIFICATION_RATE=eighty percent

# Minutes before a slot to place the call. Independent of the email.
CALL_LEAD_MINUTES=30

# How to render the stored E.164 number for the API:
# 'national' sends 9876543210, 'e164' sends +919876543210.
CALLER_PHONE_FORMAT=national
